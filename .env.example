# ==========================================
# Database Configuration (PostgreSQL)
# ==========================================
# Local PostgreSQL, Neon, Supabase, or any PostgreSQL-compatible instance
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vitto_lending?schema=public"

# ==========================================
# Firebase Client Authentication
# ==========================================
# Obtain from Firebase Console > Project Settings > General > Your apps (Web)
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyYourFirebaseWebApiKeyHere"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-app-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-app-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-app-id.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# ==========================================
# Firebase Admin SDK (Server Token Verification)
# ==========================================
# Option A: Individual service account parameters
FIREBASE_PROJECT_ID="your-app-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-app-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Option B (Alternative): Full Service Account JSON as single-line string
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"..."}'

# ==========================================
# Testing & Local Development
# ==========================================
# Set to "true" to allow mock authentication tokens (e.g. "Bearer test-token-admin") during automated testing or local demo without live Firebase credentials
ENABLE_TEST_AUTH="true"
